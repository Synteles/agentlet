# Example .env file for Agentlet Core
# Copy this to .env and fill in your actual values
#
# Provider environment variables below are examples. Always check the latest
# LiteLLM documentation for your provider: https://docs.litellm.ai/docs/providers

# ============================================================================
# Anthropic
# ============================================================================
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# OpenAI
# ============================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORGANIZATION=your_organization_id (optional)
# OPENAI_BASE_URL=https://api.openai.com/v1 (optional, override for proxies)

# ============================================================================
# AWS Bedrock
# ============================================================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION_NAME=us-east-1

# ============================================================================
# Azure OpenAI
# ============================================================================
# AZURE_API_KEY=your_azure_api_key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-01

# ============================================================================
# Google Gemini
# ============================================================================
# GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Ollama (local)
# ============================================================================
# No API key required. Ollama has no native LiteLLM env vars — configure
# api_base in your agentlet YAML (default: http://localhost:11434).
# You can define a variable here and reference it in YAML via ${OLLAMA_BASE_URL}.
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# MCP Tools
# ============================================================================
# BRAVE_API_KEY=your_brave_search_api_key
# SERP_API_KEY=your_serp_api_key

# ============================================================================
# Agentlet Configuration
# ============================================================================
# Docker image tag used by docker-compose (edge = latest build, latest = latest stable)
# AGENTLET_TAG=edge

# Debug mode
# DEBUG=false

# Log level
# LOG_LEVEL=INFO
