# Example .env file for Agentlet Core
# Copy this to .env and fill in your actual values

# ============================================================================
# Anthropic Configuration (for Anthropic Foundry)
# ============================================================================
# Required for using Anthropic models via Foundry
ANTHROPIC_FOUNDRY_API_KEY=your_foundry_api_key_here
ANTHROPIC_FOUNDRY_RESOURCE=your_foundry_resource_name
ANTHROPIC_CHAT_MODEL_ID=claude-sonnet-4-5

# ============================================================================
# Standard Anthropic API (alternative to Foundry)
# ============================================================================
# If using standard Anthropic API instead of Foundry
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# AWS Bedrock Configuration
# ============================================================================
# Required for using AWS Bedrock models
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# OpenAI Configuration
# ============================================================================
# Required for using OpenAI models
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORG_ID=your_organization_id (optional)

# ============================================================================
# MCP Tools Configuration
# ============================================================================
# API keys for MCP tools (e.g., web search)
# BRAVE_API_KEY=your_brave_search_api_key
# SERP_API_KEY=your_serp_api_key

# ============================================================================
# Other Configuration
# ============================================================================
# Docker image tag used by docker-compose (edge = latest build, latest = latest stable)
# AGENTLET_TAG=edge

# Debug mode
# DEBUG=false

# Log level
# LOG_LEVEL=INFO
